{
  "name": "netflix-like-player",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify-dist.mjs",
    "package": "node scripts/package.mjs",
    "release:check": "npm run typecheck && npm test && npm run build && npm run verify",
    "permissions:update": "node scripts/verify-dist.mjs --print-permissions > scripts/permissions.lock.json",
    "version": "node scripts/sync-version.mjs && git add public/manifest.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "postcss": "^8.5.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
